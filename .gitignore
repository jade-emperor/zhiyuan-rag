# Python-generated files
__pycache__/
*.py[oc]
/build/
/dist/
/wheels/
*.egg-info
*.ses
/logs/

# 本地工作材料：只在磁盘上保留，不进版本库
#   /data/     语料与评估集（**课程方版权** + 体积大）—— 永不公开
#   /models/   模型权重（4.4G，按 README 第一节下载）
/data/
/models/

/docs/

# 脚本：默认不公开；契约与反向测试公开（可验证性的根），工具里排除一次性脚本
/scripts/*
!/scripts/README.md
!/scripts/dev.sh
!/scripts/acceptance/
!/scripts/tools/
/scripts/tools/extract_lecture.py

# Virtual environments
.venv

# 存放密钥等
.env

# 生成物（临时实验等），可随时重建
/.cache/

# 前端：源码与 package-lock 进版本库,**依赖目录与构建中间产物不进**
#   （构建产物落在 src/project_rag/api/static/app/ 下,那是入库的 —— 见 docs/frontend.md §1）
#   ⚠️ `web/scripts/` 要进版本库（source-digest.mjs 是 build 的一环），别在这里写 `scripts/`
web/node_modules/
web/dist/
