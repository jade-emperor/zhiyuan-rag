# Python-generated files
__pycache__/
*.py[oc]
/build/
/dist/
/wheels/
*.egg-info
*.ses
/logs/

# 本地工作材料：只在磁盘上保留，不进版本库
#   /data/     语料与评估集（**第三方版权** + 体积大）—— 永不公开
#   /models/   模型权重（4.4G，按 README 第一节下载）
#   /.trash/   清退数据的隔离区（培训课程资料等），确认无副作用后整目录删掉
/data/
/models/
/.trash/

/docs/
# AGENTS.md 是**给本机 agent 的工作说明**（含本机型号 / 路径 / 实测日期），与 docs/ 同类：
# 留在磁盘上给 agent 读，但不随仓库发布。
/AGENTS.md

# 脚本：默认不公开；契约与反向测试公开（可验证性的根）
/scripts/*
!/scripts/README.md
!/scripts/dev.sh
!/scripts/acceptance/
#   `/scripts/tools/` **整目录不公开**（作者要求）：里面基本是一次性的个人工具 ——
#   造评估集、下模型、灌 FAQ、跑 RAGAS、A/B 读数，命令只有这台机器上跑得通，
#   挂到公开仓库只会让人照着敲一遍然后失败。
#
#   **两条代价，要恢复哪一条就把对应文件单独 `!` 放行**：
#     ① `check_m2_faq` / `check_m4_eval` 里引用到它们的那几条 → 公开 clone 上转成
#        **SKIP 并点名 owner**（不算通过，但也不会红）；
#     ② `reverse_p0_4` 的 A/B 用例会**红** —— 它要改 `ab_retrieval.py` 的源码，
#        而「锚点找不到 = 那条反向测试没跑 = 失败」是本项目自己的规矩
#        （见 `_harness.patched_source` 的 docstring）。想让它复活就加
#        `!/scripts/tools/ab_retrieval.py`。
/scripts/tools/

# Virtual environments
.venv

# 存放密钥等
.env

# 生成物（临时实验等），可随时重建
/.cache/

# 前端：源码与 package-lock 进版本库,**依赖目录与构建中间产物不进**
#   （构建产物落在 src/project_rag/api/static/app/ 下,那是入库的 —— 见 docs/frontend.md §1）
#   ⚠️ `web/scripts/` 要进版本库（source-digest.mjs 是 build 的一环），别在这里写 `scripts/`
web/node_modules/
web/dist/
