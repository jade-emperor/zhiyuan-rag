# Python-generated files
__pycache__/
*.py[oc]
/build/
/dist/
/wheels/
*.egg-info
*.ses
/logs/

# 本地工作材料：只在磁盘上保留，不进版本库
#   /data/     语料与评估集（**第三方版权** + 体积大）—— 永不公开
#   /models/   模型权重（4.4G，按 README 第一节下载）
#   /.trash/   清退数据的隔离区（培训课程资料等），确认无副作用后整目录删掉
/data/
/models/
/.trash/

/docs/
# AGENTS.md 是**给本机 agent 的工作说明**（含本机型号 / 路径 / 实测日期），与 docs/ 同类：
# 留在磁盘上给 agent 读，但不随仓库发布。
/AGENTS.md

# 脚本：默认不公开；契约与反向测试公开（可验证性的根）
/scripts/*
!/scripts/README.md
!/scripts/dev.sh
!/scripts/acceptance/
# `/scripts/tools/` **整目录不公开**：里面基本是一次性的个人工具 ——
/scripts/tools/

# Virtual environments
.venv

# 存放密钥等
.env

# 生成物（临时实验等），可随时重建
/.cache/

# 前端：源码与 package-lock 进版本库，**依赖目录与构建中间产物不进**
#（web/dist 是可独立部署的产物，已忽略；`npm run build` 会在
#  src/project_rag/api/static/app/ 留一份入库的兼容副本，供桌面壳/一体化模式使用）
#   ⚠️ `web/scripts/` 要进版本库（source-digest / sync-python-bundle 是 build 的一环）
web/node_modules/
web/dist/
