# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.ses
logs/

# 本地工作材料：只在磁盘上保留，不进版本库
#   data/    语料与评估集（课程方版权 + 体积大），来源与形状见 data/README.md
#   docs/    讲义底稿、STATUS、决策登记（deferred.md）
#   scripts/ 验收脚本与一次性工具
# 换机器时按各自 README 重建；历史里已有的版本仍可从 git log 取回。
data/
docs/
scripts/

# Virtual environments
.venv

# 存放密钥等
.env

# 生成物（讲义提取、临时实验等），可随时重建
.cache/

# 模型权重（bge-m3 / bge-reranker-v2-m3 各 2.2G）
# 不进版本库：体积大 + 可以从课程包本地拷贝或 modelscope 下载
# 取模型：.venv/bin/python scripts/tools/fetch_models.py [--with-reranker]
models/