RAG_LLM__DEEPSEEK_API_KEY=your_api_key
RAG_MYSQL__PASSWORD=your_mysql_password
RAG_REDIS__PASSWORD=your_redis_password

# ── 阿里云 OSS(图片模态)──────────────────────────────────────────────
# 字段名跟 config.py 的 OssConfig 一一对应;RAG_ 前缀与 __ 层级都不是装饰。
RAG_OSS__ACCESSKEY_ID=your_access_key_id
RAG_OSS__ACCESSKEY_SECRET=your_access_key_secret
RAG_OSS__REGION=cn-guangzhou
RAG_OSS__BUCKET=your-bucket
# 后端上传/HEAD 用。本机/WSL 必须是公网地址;同地域 ECS 才可以用 -internal。
RAG_OSS__ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
# 签名 URL 用;留空 = 与 ENDPOINT 相同。用 -internal 上传时必须填公网地址。
# RAG_OSS__PUBLIC_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
RAG_OSS__PREFIX=rag/images
# signed = 后端签短链(浏览器/模型直连 OSS);proxy 尚未实现。
RAG_OSS__URL_MODE=signed
RAG_OSS__SIGN_EXPIRES_S=300
RAG_OSS__CONNECT_TIMEOUT_S=5
RAG_OSS__UPLOAD_TIMEOUT_S=30
RAG_OSS__MAX_RETRIES=3

# ── 图片模态 ─────────────────────────────────────────────────────────
# 默认关:关掉时 PDF 仍走 PyMuPDF,MinerU/OSS 一次都不碰。
RAG_IMAGES__ENABLED=false
RAG_IMAGES__MAX_PER_DOC=50
RAG_IMAGES__MIN_BYTES=2048
RAG_IMAGES__MAX_BYTES=10485760
RAG_IMAGES__ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ── MinerU 独立解析服务 ──────────────────────────────────────────────
# compose 里的服务名是 mineru;手工在宿主跑时改成 http://127.0.0.1:18082。
# 宿主 CLI 用 127.0.0.1:18082(compose 已把 mineru 的 8000 映射到宿主回环);
# app 容器在 compose 里覆盖成 http://mineru:8000,不读这一行。
RAG_MINERU__BASE_URL=http://127.0.0.1:18082
RAG_MINERU__TOKEN=change-me
RAG_MINERU__TIMEOUT_S=3600
RAG_MINERU__POLL_INTERVAL_S=2
RAG_MINERU__CACHE_DIR=data/mineru

# 注:`docker compose up -d` 起的 `app` 服务**已经**在 compose 里把中间件地址设成服务名了
# (见 docker-compose.yaml 的 app.environment),所以下面三行只在手工 `docker run` 时才需要抄。
#
# 其他可覆盖项(优先级:环境变量 > 这里 > config/config.yaml)如:
# RAG_EMBEDDING__DEVICE=cpu      # 没有 GPU / 在容器里跑
# RAG_RAG__RERANK=false          # 关重排:省一次模型加载,检索退回纯融合排序
# RAG_API__WARMUP=false          # 起服务时不预热(首个请求自己扛冷启动)
